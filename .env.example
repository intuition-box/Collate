# Required
INTUITION_PIN_API_KEY=

# Required to record local activity; production activity also needs it
DATABASE_URL=

# Optional: development-only read source when DATABASE_URL is not set
# Defaults to https://collate.intuition.box
ACTIVITY_READ_ORIGIN=

# Required for the private settings page
ADMIN_PASSWORD_HASH=
ADMIN_AUTH_SECRET=

# Optional wallet connection
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional app metadata
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional ENS resolution RPC override
ETHEREUM_RPC_URL=

# Optional Intuition endpoint overrides
NEXT_PUBLIC_INTUITION_MAINNET_RPC_URL=
NEXT_PUBLIC_INTUITION_TESTNET_RPC_URL=
INTUITION_MAINNET_GRAPHQL_URL=
INTUITION_TESTNET_GRAPHQL_URL=
NEXT_PUBLIC_INTUITION_MAINNET_EXPLORER_URL=
NEXT_PUBLIC_INTUITION_TESTNET_EXPLORER_URL=
